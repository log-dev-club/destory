# 데이터베이스 연결 URL (형식: postgres://user:password@host:port/dbname)
# 예시: postgres://postgres:1234@localhost:5432/destory
DATABASE_URL=postgres://user:password@localhost:5432/destory

# 서버 실행 포트
SERVER_PORT=8080

# 로그 레벨 설정 (tracing 라이브러리용)
# 옵션: error, warn, info, debug, trace
RUST_LOG=api=info

# 게시물 업로드 알림용 Discord Webhook URL
# Discord 채널 설정 > 연동 > 웹후크 에서 발급
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# 첨부파일 저장 디렉토리 (api/ 기준 상대경로 또는 절대경로)
UPLOAD_DIR=./uploads

# 첨부파일 최대 크기 (MB)
MAX_UPLOAD_MB=100

# 로그인 세션 유지 기간 (일)
SESSION_TTL_DAYS=30

# Discord 알림에 포함될 게시물 링크의 기준 URL (프론트엔드 주소)
APP_BASE_URL=http://localhost:5173
