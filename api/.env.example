# 데이터베이스 연결 URL (형식: postgres://user:password@host:port/dbname)
# 예시: postgres://postgres:1234@localhost:5432/destory
DATABASE_URL=postgres://user:password@localhost:5432/destory

# 서버 실행 포트
SERVER_PORT=8080

# 로그 레벨 설정 (tracing 라이브러리용)
# 옵션: error, warn, info, debug, trace
RUST_LOG=api=info

# 게시물 업로드 알림용 Discord Webhook URL
# Discord 채널 설정 > 연동 > 웹후크 에서 발급
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# 첨부파일 저장 디렉토리 (api/ 기준 상대경로 또는 절대경로)
UPLOAD_DIR=./uploads

# 첨부파일 최대 크기 (MB)
MAX_UPLOAD_MB=100

# 로그인 세션 유지 기간 (일)
SESSION_TTL_DAYS=30

# Discord 알림에 포함될 게시물 링크의 기준 URL (프론트엔드 주소)
APP_BASE_URL=http://localhost:5173

# GitHub OAuth 로그인 (선택). 비워두면 GitHub 로그인 버튼이 숨겨진다.
# GitHub > Settings > Developer settings > OAuth Apps 에서 발급.
# Authorization callback URL 은 아래 GITHUB_REDIRECT_URL 과 정확히 같아야 한다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 미설정 시 {APP_BASE_URL}/api/auth/github/callback (Vite 프록시를 거쳐 백엔드로 전달됨)
GITHUB_REDIRECT_URL=

# 로그인·회원가입·GitHub 로그인 시작에 대한 IP 당 분당 허용 요청 수 (무차별 대입 방어)
AUTH_RATE_LIMIT_PER_MINUTE=10

# 리버스 프록시(nginx, Caddy 등) 뒤에 배포할 때만 true. X-Forwarded-For 헤더의 IP 를 신뢰한다.
# 서버가 직접 노출된 환경에서 true 로 두면 헤더 위조로 제한을 우회할 수 있다.
TRUST_PROXY_HEADERS=false
