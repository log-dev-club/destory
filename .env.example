# docker compose 용 환경 변수. 이 파일을 .env 로 복사해서 채운다 (.env 는 커밋 금지).
# 로컬 개발(cargo run / npm run dev)은 이 파일이 아니라 api/.env 를 사용한다.

# --- 필수 ---
# DB 비밀번호. 컨테이너 내부에서만 쓰이지만 강한 값으로
POSTGRES_PASSWORD=

# --- 주소 ---
# Caddy 가 바인딩할 주소.
#   :80                  → HTTP (개인 PC, 내부망, 도메인 없음)
#   destory.example.com  → HTTPS 자동 (도메인이 이 서버를 가리키고 80/443 이 열려 있어야 함)
SITE_ADDRESS=:80

# 브라우저에서 접속하는 주소. Discord 알림 링크와 GitHub 콜백 URL 의 기준
#   http://localhost  /  http://192.168.0.10  /  https://destory.example.com
APP_BASE_URL=http://localhost

# HTTPS(도메인) 배포면 true. HTTP 에서 true 로 두면 로그인이 안 된다
COOKIE_SECURE=false

# --- 선택 ---
MAX_UPLOAD_MB=100
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
RUST_LOG=api=info

# Discord 알림 (비우면 비활성)
DISCORD_WEBHOOK_URL=

# GitHub 로그인 (비우면 비활성). 배포 주소에 맞는 OAuth App 을 별도로 만들어야 한다.
# OAuth App 의 callback URL = {APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=
